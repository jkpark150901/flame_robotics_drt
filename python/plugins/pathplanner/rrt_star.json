{
    "planner_backend": "ompl",
    "algorithm": "rrt_star",
    "step_size": 0.1,
    "max_iter": 10000,
    "search_radius": 0.2,
    "goal_bias": 0.2,
    "goal_check_interval": 10,
    "early_stop_on_goal": true,
    "terminate_on_first_solution": false,
    "solution_patience": 300,
    "normalize_joint_space": true,
    "use_joint_space_planning": true,
    "debug_exploration": true,
    "debug_solution_paths": true,
    "debug_output_dir": "debug/rrt_star",
    "state_space": {
        "normalize_joint_space": true,
        "goal_tolerance": 0.000001
    },
    "collision": {
        "motion_validator": "discrete",
        "normalized_resolution": 0.02,
        "final_verify": true
    },
    "solve": {
        "timeout_sec": 5.0,
        "allow_approximate_solution": false,
        "stop_on_first_solution": false,
        "convergence_slice_sec": 0.1
    },
    "objective": {
        "type": "path_length"
    },
    "planner": {
        "range": 0.1,
        "goal_bias": 0.2,
        "rewire_factor": 1.1
    },
    "debug": {
        "save_planner_data": true,
        "save_convergence": true,
        "save_summary": true
    },
    "workspace_bounds": {
        "x_min": -50.0,
        "x_max": 50.0,
        "y_min": -50.0,
        "y_max": 50.0,
        "z_min": -50.0,
        "z_max": 50.0
    }
}
