{
    "planner_backend": "ompl",
    "algorithm": "bit_star",
    "batch_size": 100,
    "eta": 1.1,
    "max_iter": 1000,
    "use_joint_space_planning": true,
    "normalize_joint_space": true,
    "debug_convergence": true,
    "debug_output_dir": "debug/bit_star",
    "collision": {
        "motion_validator": "discrete",
        "normalized_resolution": 0.02,
        "final_verify": true
    },
    "solve": {
        "timeout_sec": 5.0,
        "allow_approximate_solution": false,
        "stop_on_first_solution": false,
        "convergence_slice_sec": 0.1
    },
    "objective": {
        "type": "path_length"
    },
    "planner": {
        "range": 0.1,
        "rewire_factor": 1.1,
        "bit_star": {
            "samples_per_batch": 100,
            "pruning": true
        }
    },
    "debug": {
        "save_summary": true
    },
    "workspace_bounds": {
        "x_min": -200.0,
        "x_max": 200.0,
        "y_min": -200.0,
        "y_max": 200.0,
        "z_min": -200.0,
        "z_max": 200.0
    }
}
