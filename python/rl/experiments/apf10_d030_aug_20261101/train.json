{
  "env": {
    "robot": "dda_rb10_1300e",
    "train_snapshots": [
      "sample/planning_snapshot_p1_2.apfgoal.pkl",
      "sample/planning_snapshot_p2_3.apfgoal.pkl",
      "sample/planning_snapshot_p3_6.apfgoal.pkl"
    ],
    "eval_snapshots": [
      "sample/planning_snapshot_p1_2.apfgoal.pkl",
      "sample/planning_snapshot_p2_3.apfgoal.pkl",
      "sample/planning_snapshot_p3_6.apfgoal.pkl"
    ],
    "max_steps": 500,
    "dt": 0.1,
    "max_rot_vel_deg": 50.0,
    "max_lin_vel": 0.5,
    "obs_distance_cap": 0.3,
