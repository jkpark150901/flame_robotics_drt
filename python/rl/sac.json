{
    "env": {
        "robot": "dda_rb10_1300e",
        "train_snapshots": [
            "sample/planning_snapshot_p1_2.pkl",
            "sample/planning_snapshot_p2_3.pkl"
        ],
        "eval_snapshots": [
            "sample/planning_snapshot_p3_6.pkl"
        ],
        "max_steps": 300,
        "dt": 0.1,
        "max_rot_vel_deg": 50.0,
        "max_lin_vel": 0.5,
