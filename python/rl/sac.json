        "time": 0.1,
        "smooth": 0.05,
        "collision": 100.0,
        "goal": 100.0
    },
    "sac": {
        "net_arch": [
            256,
            256,
            256
        ],
        "learning_rate": 0.0003,
        "buffer_size": 1000000,
        "batch_size": 512,
        "gamma": 0.99,
        "tau": 0.005,
        "ent_coef": "auto",
        "train_freq": 1,
        "gradient_steps": 8,
        "learning_starts": 5000,
        "n_envs": 16,
        "total_timesteps": 1000000,
        "device": "cuda"
    }
